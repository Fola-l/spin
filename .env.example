# Copy this file to .env and fill in your own values.
# Never commit .env — it holds a private key.

# --- Client-side (frontend) ---
# These MUST be prefixed with VITE_ or Vite will not expose them to the browser
# bundle. They are plain contract addresses, not secrets, but still belong in
# env vars so they can differ per deployment (local dev vs. Vercel).
# Also set these two in your Vercel project's Environment Variables when you
# deploy — Vercel does not read this repo's .env file.

# Your existing FLD ERC-20 token address.
VITE_FLD_TOKEN_ADDRESS=

# The ClassroomStaking contract address, after you deploy it (via Remix or
# `npm run contracts:deploy:sepolia`).
VITE_STAKING_CONTRACT_ADDRESS=

# --- Hardhat-only (used for compiling/testing/deploying contracts) ---
# These never reach the browser bundle.

# An RPC endpoint for Sepolia (e.g. from Alchemy, Infura, or a public endpoint).
SEPOLIA_RPC_URL=

# The private key of the wallet you want to deploy from and act as the
# teacher/owner. This account pays gas and is the only one that can call
# startRound / lockRound / resolveCorrect / resolveWrong once deployed.
# Only needed if you use `npm run contracts:deploy:sepolia` instead of Remix.
DEPLOYER_PRIVATE_KEY=

# Optional: only needed if you want to verify the contract source on Etherscan.
ETHERSCAN_API_KEY=
